# HomeTechVN — example only
# Copy to .env.local and fill values.
# DO NOT COMMIT .env.local

APP_ENV=local
APP_TIMEZONE=Asia/Bangkok

# Browser/PWA safe when RLS is correctly enabled:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# BACKEND ONLY. Never prefix with VITE_.
# Do not use in React/browser.
SUPABASE_SECRET_KEY=
